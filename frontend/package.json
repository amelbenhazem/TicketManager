{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "npx eslint . --ignore-pattern coverage/ --ignore-pattern playwright-report/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
