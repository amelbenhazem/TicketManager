# Copier ce fichier en terraform.tfvars (non versionné) et renseigner les valeurs.

subscription_id             = "YOUR_SUBSCRIPTION_ID"
tenant_id                   = "YOUR_TENANT_ID"
client_id                   = "YOUR_CLIENT_ID"
client_secret               = "YOUR_CLIENT_SECRET"
stack_metadata_host         = "management.dc2.xpressazure.com"
stack_arm_environment_name  = "AzureStack-User-ee8e5b2b-3e31-4a83-93b6-28f3739efd6d"

resource_group_name = "AmalBH-RG"
location            = "dc2"

# Préfixe pour éviter collision avec un VNet existant (ex. ticketmanager-vnet).
project_prefix = "ticketmanager-iac"

admin_username = "azureuser"
ssh_public_key = "ssh-rsa YOUR_PUBLIC_KEY"

# Optionnel : restreindre SSH (recommandé en production)
# ssh_source_address_prefix = "203.0.113.10/32"

# Taille VM — réduire (ex. Standard_D1_v2) en cas de FabricVmPlacementError sur Stack Hub
vm_size_gestion = "Standard_D1_v2"
vm_size_db      = "Standard_D2s_v3"

# true = rattacher le disque OS existant (vm-gestion-os) après suppression de la VM
# false = première création depuis l'image Ubuntu (nouvel environnement)
vm_gestion_attach_existing_os_disk = true
