# Copier ce fichier en terraform.tfvars (non versionné) et renseigner les valeurs.

subscription_id             = "YOUR_SUBSCRIPTION_ID"
tenant_id                   = "YOUR_TENANT_ID"
stack_metadata_host         = "management.YOUR_LOCATION.xpressazure.com"
stack_arm_environment_name  = "AzureStack-User-YOUR-GUID"

resource_group_name = "YOUR_RESOURCE_GROUP"
location            = "YOUR_LOCATION"

# Préfixe pour éviter collision avec un VNet existant (ex. ticketmanager-vnet).
project_prefix = "ticketmanager-iac"

admin_username = "azureuser"
ssh_public_key = "ssh-rsa YOUR_PUBLIC_KEY"

# Optionnel : restreindre SSH (recommandé en production)
# ssh_source_address_prefix = "203.0.113.10/32"
