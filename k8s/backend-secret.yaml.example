# Copier vers backend-secret.yaml et adapter (ne pas commiter).
# kubectl apply -f backend-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: ticketmanager
type: Opaque
stringData:
  MONGODB_URI: "mongodb://10.1.2.4:27017/ticketmanager"
  JWT_SECRET: "change-me-use-openssl-rand-base64-64"
  JWT_EXPIRES_IN: "7d"
  NODE_ENV: "production"
  PORT: "3001"
  # Origines autorisées (CORS) — adapter selon NodePort / URL d'accès frontend
  CORS_ORIGIN: "http://10.1.3.4:30080,http://10.1.3.5:30080,http://localhost:3000"
