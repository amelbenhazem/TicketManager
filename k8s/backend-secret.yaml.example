# Copier vers backend-secret.yaml et adapter (ne pas commiter).
# kubectl apply -f backend-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: ticketmanager
type: Opaque
stringData:
  MONGODB_URI: "mongodb://mongodb:27017/ticketmanager"
  JWT_SECRET: "change-me-use-openssl-rand-base64-64"
  JWT_EXPIRES_IN: "7d"
  NODE_ENV: "production"
  PORT: "3001"
  # Origines autorisées (CORS) — HTTPS Ingress + NodePort interne
  CORS_ORIGIN: "https://app.ticketmanager.local:30443,http://10.1.3.4:30080,http://10.1.3.5:30080"
  CLOUDINARY_CLOUD_NAME: "your_cloud_name"
  CLOUDINARY_API_KEY: "your_api_key"
  CLOUDINARY_API_SECRET: "your_api_secret"
