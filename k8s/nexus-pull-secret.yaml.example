# Copier vers nexus-pull-secret.yaml et remplir les credentials (ne pas commiter).
# kubectl apply -f nexus-pull-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: nexus-registry
  namespace: ticketmanager
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: |
    {
      "auths": {
        "10.1.1.4:8082": {
          "username": "admin",
          "password": "CHANGE_ME",
          "auth": "BASE64_USER_PASS"
        }
      }
    }
