# Server (3001 pour éviter conflit avec le frontend Next.js sur 3000)
PORT=3001
NODE_ENV=development

# MongoDB (ne jamais commiter l'URI réelle avec mot de passe)
MONGODB_URI=mongodb://localhost:27017/ticketmanager

# JWT (en prod : générer une clé forte, ex. openssl rand -base64 64)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# CORS (origines autorisées, séparées par des virgules)
# Inclure l’URL du frontend (ex. 3001 si backend sur 3000)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Compte démo (optionnel ; en prod utiliser la base utilisateurs)
# AUTH_DEMO_EMAIL=demo@rfc.tn
# AUTH_DEMO_PASSWORD=demo123

# Cloudinary (pièces jointes des tickets — https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
