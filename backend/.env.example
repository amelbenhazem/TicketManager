# Server (3001 pour éviter conflit avec le frontend Next.js sur 3000)
# Documentation API : http://localhost:3001/api (Swagger UI)
PORT=3001
NODE_ENV=development

# MongoDB (ne jamais commiter l'URI réelle avec mot de passe)
MONGODB_URI=mongodb://localhost:27017/ticketmanager

# JWT (en prod : générer une clé forte, ex. openssl rand -base64 64)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# CORS (origines autorisées, séparées par des virgules)
# Inclure l’URL du frontend (ex. 3001 si backend sur 3000)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Comptes locaux : npm run seed (admin@rfc.com, client1@rfc.com, etc. — voir scripts/seed.ts)
# En production : créer les admins via l’API / portail, jamais de compte démo codé en dur.

# Cloudinary (pièces jointes des tickets — https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
