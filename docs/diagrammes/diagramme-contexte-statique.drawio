<mxfile host="app.diagrams.net" agent="TicketManager" version="22.1.0">
  <diagram id="context-static" name="Contexte statique">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Titre -->
        <mxCell id="title" value="Diagramme de contexte statique — TicketManager" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="280" y="25" width="600" height="35" as="geometry" />
        </mxCell>

        <!-- Système central -->
        <mxCell id="system" value="&lt;b&gt;TicketManager&lt;/b&gt;&lt;br&gt;&lt;br&gt;Plateforme web de gestion&lt;br&gt;des tickets de support IT&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(Frontend Next.js + API NestJS&lt;br&gt;+ base MongoDB)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=3;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="280" width="280" height="160" as="geometry" />
        </mxCell>

        <!-- Acteur Client -->
        <mxCell id="actor-client" value="Client" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="120" y="300" width="50" height="90" as="geometry" />
        </mxCell>
        <mxCell id="desc-client" value="&lt;b&gt;Acteur initiateur&lt;/b&gt;&lt;br&gt;• Soumet des tickets (demande / incident)&lt;br&gt;• Consulte l’état d’avancement&lt;br&gt;• Accès restreint à ses propres données" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="220" height="75" as="geometry" />
        </mxCell>

        <!-- Acteur Technicien -->
        <mxCell id="actor-tech" value="Technicien" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="540" y="80" width="50" height="90" as="geometry" />
        </mxCell>
        <mxCell id="desc-tech" value="&lt;b&gt;Acteur opérationnel&lt;/b&gt;&lt;br&gt;• Traite les tickets assignés&lt;br&gt;• Consulte le détail des incidents&lt;br&gt;• Fait évoluer le statut (résolution)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="450" y="30" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- Acteur Administrateur -->
        <mxCell id="actor-admin" value="Administrateur" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="980" y="300" width="50" height="90" as="geometry" />
        </mxCell>
        <mxCell id="desc-admin" value="&lt;b&gt;Acteur de supervision&lt;/b&gt;&lt;br&gt;• Accès complet au système&lt;br&gt;• Gère utilisateurs et rôles&lt;br&gt;• Assigne les tickets aux techniciens&lt;br&gt;• Consulte les statistiques globales" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="820" y="420" width="240" height="85" as="geometry" />
        </mxCell>

        <!-- Relations Client → Système -->
        <mxCell id="link-client" value="soumet et consulte&#xa;ses tickets" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#6c8ebf;fontSize=11;fontStyle=1" edge="1" parent="1" source="actor-client" target="system">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Relations Technicien → Système -->
        <mxCell id="link-tech" value="traite et met à jour&#xa;les tickets assignés" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#d6b656;fontSize=11;fontStyle=1" edge="1" parent="1" source="actor-tech" target="system">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Relations Admin → Système -->
        <mxCell id="link-admin" value="supervise, assigne,&#xa;gère les utilisateurs" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#82b366;fontSize=11;fontStyle=1" edge="1" parent="1" source="actor-admin" target="system">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Légende périmètre -->
        <mxCell id="legend" value="&lt;b&gt;Périmètre fonctionnel&lt;/b&gt;&lt;hr&gt;Chaque acteur interagit avec TicketManager selon un rôle (RBAC) :&lt;br&gt;droits d’accès strictement délimités côté API (JWT + guards NestJS)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#ffffcc;strokeColor=#999999;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="500" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- Optionnel : systèmes externes (niveau contexte élargi) -->
        <mxCell id="ext-mongo" value="MongoDB&#xa;(persistance)" style="shape=mxgraph.flowchart.database;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="620" width="90" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ext-cloud" value="Cloudinary&#xa;(pièces jointes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="620" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="link-mongo" value="&lt;&lt;utilise&gt;&gt;" style="endArrow=open;dashed=1;html=1;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="system" target="ext-mongo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="link-cloud" value="&lt;&lt;utilise&gt;&gt;" style="endArrow=open;dashed=1;html=1;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="system" target="ext-cloud">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note-ext" value="[optionnel] Systèmes externes — hors acteurs métier" style="text;html=1;align=center;fontSize=9;fontColor=#666666;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="420" y="690" width="260" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
