        </mxCell>

        <mxCell id="m12" value="12. TicketResponse" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="505" y="545" as="sourcePoint" />
